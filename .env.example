# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.
# Entorno de settings: config.settings.local (desarrollo/tests) o config.settings.produccion
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# PostgreSQL, p. ej. postgres://usuario:clave@localhost:5432/cuadro_mandos (Postgres.app) o la URL de Neon  # pragma: allowlist secret
DATABASE_URL=
SUBIDA_MAX_MB=50
# IA (ADR-005): la clave y los modelos solo por entorno
ANTHROPIC_API_KEY=
IA_MODELO_CLASIFICAR=
IA_MODELO_EXTRAER=
IA_MODELO_REDACTAR=

# ADR-003: guardar los PDF y Word originales en media/ (true/false)
GUARDAR_ORIGINALES=true
