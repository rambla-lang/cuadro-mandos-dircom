# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.
# Entorno de settings: config.settings.local (desarrollo/tests) o config.settings.produccion
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# PostgreSQL, p. ej. postgres://usuario:clave@localhost:5432/cuadro_mandos (Postgres.app) o la URL de Neon  # pragma: allowlist secret
DATABASE_URL=
SUBIDA_MAX_MB=50
# IA (ADR-005): la clave y los modelos solo por entorno
ANTHROPIC_API_KEY=
IA_MODELO_CLASIFICAR=
IA_MODELO_EXTRAER=
IA_MODELO_REDACTAR=
# Identificadores vigentes (docs/06): claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5
IA_ACTIVADA=true
# Gasto máximo estimado al mes; 0 bloquea todas las llamadas
IA_LIMITE_MENSUAL_EUR=0
# Precios por millón de tokens desde la página oficial, p. ej. {"claude-haiku-5-5": {"entrada": 0.1, "salida": 0.5}}
IA_PRECIOS_JSON={}
IA_FALLBACKS=true

# ADR-003: guardar los PDF y Word originales en media/ (true/false)
GUARDAR_ORIGINALES=true
